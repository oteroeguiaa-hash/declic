# À recopier dans Vercel → Project → Settings → Environment Variables

# Anthropic (analyse des photos)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (comptes, quotas, annonces, avis) → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # clé publique, envoyée au navigateur
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # clé secrète, jamais dans le navigateur

# Stripe (abonnements) → Developers → API keys / Webhooks, Product catalog
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PLUS=price_...         # prix mensuel de l'offre Pro (11,99 €)
STRIPE_PRICE_PRO=price_...          # prix mensuel de l'offre Ultra (18,99 €)

# Adresse publique du site (sert aux retours de paiement)
SITE_URL=https://ton-domaine.fr

# E-mails autorisés à valider les avis clients (séparés par des virgules)
ADMIN_EMAILS=toi@exemple.fr

# Garde-fou de l'offre Ultra « illimitée » : analyses max par mois et par compte
ULTRA_MONTHLY_CAP=300
